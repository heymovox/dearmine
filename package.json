{
  "name": "dearmine",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Dearmine — create and publish personalized romantic surprise websites.",
  "scripts": {
    "dev": "concurrently -n web,api -c magenta,cyan \"npm:dev:web\" \"npm:dev:api\"",
    "dev:web": "vite",
    "dev:api": "tsx watch server/index.ts",
    "build": "npm run build:web && npm run build:api",
    "build:web": "tsc -b tsconfig.app.json && vite build",
    "build:api": "tsup server/index.ts --format esm --platform node --target node20 --out-dir server/dist --clean --sourcemap",
    "typecheck": "tsc -b tsconfig.app.json tsconfig.api.json --pretty",
    "lint": "oxlint",
    "test": "vitest run",
    "test:watch": "vitest",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "start:api": "node server/dist/index.js",
    "preview": "vite preview"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.699.0",
    "@aws-sdk/s3-request-presigner": "^3.699.0",
    "@hookform/resolvers": "^3.10.0",
    "@prisma/client": "^6.2.1",
    "@tanstack/react-query": "^5.62.0",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "framer-motion": "^14.3.0",
    "helmet": "^8.0.0",
    "lucide-react": "^1.57.0",
    "nodemailer": "^7.0.11",
    "razorpay": "^2.9.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.54.2",
    "react-router-dom": "^7.1.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.25",
    "@types/node": "^24.13.3",
    "@types/nodemailer": "^6.4.17",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/supertest": "^6.0.2",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^9.1.2",
    "oxlint": "^1.81.0",
    "prisma": "^6.2.1",
    "supertest": "^7.0.0",
    "tailwindcss": "^4.3.3",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^2.1.8"
  }
}

# ---------------------------------------------------------------------------
# LoveSurprise — environment template
# Copy to `.env` for local development. NEVER commit the real `.env`.
# ---------------------------------------------------------------------------

# --- Core ---
NODE_ENV=development
PORT=4000
# Base URL of the web app (used in emails / links)
APP_BASE_URL=http://localhost:5173
# Base URL of the API (used by the web client and for public share links)
API_BASE_URL=http://localhost:4000
# Public origin used to build published surprise links, e.g. https://lovesurprise.in
PUBLIC_SITE_URL=http://localhost:5173

# --- Database (PostgreSQL) ---
# Neon / Supabase / RDS / local Postgres connection string.
DATABASE_URL="postgresql://user:password@host:5432/lovesurprise?sslmode=require"
# Direct (non-pooled) URL used by Prisma migrations. Optional.
DIRECT_URL=""

# --- Auth / sessions ---
# 32+ byte random string. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET="replace-with-a-long-random-secret"
SESSION_TTL_DAYS=30
COOKIE_DOMAIN=

# --- Email (optional; if unset, emails are logged to the console in dev) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="LoveSurprise <no-reply@lovesurprise.in>"

# --- Payments: Razorpay ---
# Leave PAYMENT_PROVIDER=mock for local development and automated tests.
PAYMENT_PROVIDER=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Object storage: Cloudflare R2 (S3-compatible) ---
# Leave STORAGE_PROVIDER=local for local development (files saved under server/uploads).
STORAGE_PROVIDER=local
R2_ACCOUNT_ID=
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Public/CDN base for uploaded assets (e.g. https://cdn.lovesurprise.in)
PUBLIC_ASSET_BASE_URL=http://localhost:4000/uploads

# --- Admin bootstrap ---
# The first account registered with this email is promoted to admin on seed.
ADMIN_EMAIL=

# --- Personalization ---
BRAND_NAME=LoveSurprise
BRAND_TAGLINE=Every Love Story Deserves a Surprise.
SUPPORT_EMAIL=support@lovesurprise.in
CURRENCY=INR

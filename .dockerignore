# Dependencies and build output are produced inside the image.
node_modules
dist
server/dist

# Never ship local secrets or dev-only data.
.env
.env.*
!.env.example

# Local uploads (dev storage fallback).
server/uploads

# Dev / tooling noise.
.git
.github
.vscode
.idea
coverage
.vitest
*.log
npm-debug.log*

# Tests and configs not needed by the API bundle.
tests
vitest.config.ts
vercel.json
